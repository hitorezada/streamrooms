# SQLite for local/test. For the VPS, point this at Postgres instead, e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/screenshare"
DATABASE_URL="file:./dev.db"

# Generate strong random secrets for production, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Access token lifetime (short-lived) and refresh token lifetime.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Discord OAuth app — create one at https://discord.com/developers/applications
# and add both callback URLs (local + production) under OAuth2 > Redirects:
#   http://localhost:4000/api/auth/discord/callback
#   https://<your-production-domain>/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Optional: only needed if you don't want it auto-derived from RENDER_EXTERNAL_URL.
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/discord/callback"

# Comma-separated list of STUN/TURN servers exposed to the client.
# Add your own TURN server (coturn) here once it's running on the VPS, e.g.:
# STUN_URLS="stun:your-vps-ip:3478"
# TURN_URL="turn:your-vps-ip:3478"
# TURN_USERNAME="turnuser"
# TURN_CREDENTIAL="turnpassword"
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
